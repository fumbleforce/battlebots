; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="battlebots"
run/main_scene="res://scenes/dev/b_menu_game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MenuRouter="*res://ui/menus/scripts/menu_router.gd"
PlayerProfile="*res://ui/menus/scripts/player_profile.gd"

[services]

matchmaking_url="https://battlebots-fumbleforce.fly.dev"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
textures/default_filters/anisotropic_filtering_level=4

[input]

drive_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":87)]
}
drive_reverse={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":83)]
}
steer_left={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":65)]
}
steer_right={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":68)]
}
brake={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":66)]
}
nitro={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":4194325)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":32)]
}
recover={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":82)]
}
camera_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":67)]
}
ping={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":81)]
}
scoreboard={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":4194306)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode":4194305)]
}
primary={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton, "button_index":1)]
}
secondary={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton, "button_index":2)]
}
camera_recenter={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton, "button_index":3)]
}
camera_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton, "button_index":4)]
}
camera_zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton, "button_index":5)]
}


[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Bots"
3d_physics/layer_3="HitZones"
